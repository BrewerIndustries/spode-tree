[Unit]
Description=Spode Tree (Next.js) — DEV
After=network.target

[Service]
Type=simple
User=dan
WorkingDirectory=/opt/spode-tree-dev
Environment=NODE_ENV=production
# Optional settings (JARVIS_ENV=dev on dev only, SPODE_DB_PATH) live in .env.
EnvironmentFile=-/opt/spode-tree-dev/.env
ExecStart=/opt/spode-tree-dev/node_modules/.bin/next start -p 4870
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
