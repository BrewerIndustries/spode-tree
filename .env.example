# Where the SQLite file lives (optional; defaults to ./data/spode.db). Photos of
# pieces you add by hand go in an images/ folder next to it.
# Each environment has its own DB, so dev + prod never share data.
# SPODE_DB_PATH=/opt/spode-tree/data/spode.db

# Set to "dev" on the DEV deployment to show the amber non-prod banner.
# Leave UNSET on prod.
# JARVIS_ENV=dev
